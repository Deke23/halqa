# Copy to .env and adjust. The prototype runs with every value left at its default.

# Signing key for guest session tokens. Set a long random value on any public deployment.
GUEST_TOKEN_SECRET=change-me

# Storage. Leave DATABASE_URL empty to use a local SQLite file.
DATABASE_URL=
SQLITE_PATH=

# Message wording. "none" uses the approved templates only (default).
# A provider only re-words approved template text; it never takes part in routing, urgency or closure.
WORDING_PROVIDER=none

# Only if WORDING_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=

# Only if WORDING_PROVIDER=anthropic
ANTHROPIC_API_KEY=
WORDING_MODEL=
